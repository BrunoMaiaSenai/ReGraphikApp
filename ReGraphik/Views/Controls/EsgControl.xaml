<UserControl x:Class="ReGraphik.Views.Controls.EsgControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="750" d:DesignWidth="1000">

    <!-- Fundo em Gradiente Sutil -->
    <UserControl.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F1F5F9" Offset="0.0"/>
            <GradientStop Color="#F8FAFC" Offset="0.3"/>
        </LinearGradientBrush>
    </UserControl.Background>

    <!-- Transição de Entrada Fluida -->
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="UserControl.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="MainGrid" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.5"/>
                    <DoubleAnimation Storyboard.TargetName="MainTransform" Storyboard.TargetProperty="Y" From="30" To="0" Duration="0:0:0.5">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid x:Name="MainGrid" Margin="36,28,36,0">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="MainTransform"/>
        </Grid.RenderTransform>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Refinado -->
        <Grid Grid.Row="0" Margin="0,0,0,28">
            <StackPanel HorizontalAlignment="Left">
                <TextBlock Text="Painel de Impacto e Diretrizes ESG" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextoColor}"/>
                <TextBlock Text="Monitore indicadores, gerencie a conformidade corporativa e acelere sua certificação ambiental." FontSize="13" Foreground="{DynamicResource CinzaColor}" Margin="0,6,0,0"/>
            </StackPanel>

            <Button Style="{StaticResource ModernButtonStyle}" HorizontalAlignment="Right" Command="{Binding ExportarPdfCommand}" Height="42" Padding="20,0" Background="#1E40AF" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center">
                <Button.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.15" Color="#1E40AF"/>
                </Button.Effect>
                <StackPanel Orientation="Horizontal">
                    <!-- Ícone Download/PDF -->
                    <Path Data="M19,9H15V3H9V9H5L12,16L19,9M5,18V20H19V18H5Z" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Exportar Diretrizes (PDF)" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Conteúdo Principal -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,28">
            <StackPanel Margin="0">

                <!-- Grid de Cards ESG com Linhas de Destaque -->
                <Grid Margin="0,0,0,32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Card E (Ambiental) -->
                    <Grid Grid.Column="0">
                        <Border Style="{StaticResource CardInteractiveStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,14">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Border Background="#DCFCE7" CornerRadius="10" Width="40" Height="40" Margin="0,0,12,0">
                                            <Path Data="M17,8C8,10 5,16 5,22C7,22 13,20 17,14C19,11 18,9 17,8M3,2C3,2 10,3 14,7C18,11 18,17 18,17C18,17 12,18 7,13C3,9 3,2 3,2Z" 
                                                  Fill="#16A34A" Stretch="Uniform" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Environmental" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextoColor}"/>
                                            <TextBlock Text="Impacto &amp; Circularidade" FontSize="11" Foreground="{DynamicResource CinzaColor}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="#334155" FontSize="12.5" LineHeight="20" Margin="0,0,0,16"
                                           Text="Transformação de resíduos gráficos em matéria-prima circular. Redução direta da pegada de carbono e eliminação de descartes em aterros sanitários."/>

                                <Border Grid.Row="2" Background="#F0FDF4" CornerRadius="8" Padding="12,10" BorderThickness="1" BorderBrush="#DCFCE7">
                                    <StackPanel>
                                        <TextBlock Text="PILAR DE IMPACTO" FontSize="9.5" FontWeight="Bold" Foreground="#166534" Margin="0,0,0,4"/>
                                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#15803D" FontWeight="Medium" LineHeight="16">
                                            • Mapeamento de Kg cadastrados&#10;• Redução do footprint de carbono
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                        <Border Height="4" Background="#34A853" VerticalAlignment="Top" CornerRadius="16,16,0,0"/>
                    </Grid>

                    <!-- Card S (Social) -->
                    <Grid Grid.Column="2">
                        <Border Style="{StaticResource CardInteractiveStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,14">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Border Background="#DBEAFE" CornerRadius="10" Width="40" Height="40" Margin="0,0,12,0">
                                            <Path Data="M16,11C17.66,11 18.99,9.66 18.99,8C18.99,6.34 17.66,5 16,5C14.34,5 13,6.34 13,8C13,9.66 14.34,11 16,11M8,11C9.66,11 10.99,9.66 10.99,8C10.99,6.34 9.66,5 8,5C6.34,5 5,6.34 5,8C5,9.66 6.34,11 8,11M8,13C5.67,13 1,14.17 1,16.5V19H15V16.5C15,14.17 10.33,13 8,13Z" 
                                                  Fill="#2563EB" Stretch="Uniform" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Social" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextoColor}"/>
                                            <TextBlock Text="Cadeia Sustentável" FontSize="11" Foreground="{DynamicResource CinzaColor}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="#334155" FontSize="12.5" LineHeight="20" Margin="0,0,0,16"
                                           Text="Integração direta entre geradores de resíduos, cooperativas de reciclagem e catadores locais, garantindo remuneração justa e desenvolvimento social."/>

                                <Border Grid.Row="2" Background="#EFF6FF" CornerRadius="8" Padding="12,10" BorderThickness="1" BorderBrush="#DBEAFE">
                                    <StackPanel>
                                        <TextBlock Text="BENEFÍCIOS GERADOS" FontSize="9.5" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,0,4"/>
                                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#1D4ED8" FontWeight="Medium" LineHeight="16">
                                            • Homologação de pontos de coleta&#10;• Fomento à economia circular regional
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                        <Border Height="4" Background="#4285F4" VerticalAlignment="Top" CornerRadius="16,16,0,0"/>
                    </Grid>

                    <!-- Card G (Governança) -->
                    <Grid Grid.Column="4">
                        <Border Style="{StaticResource CardInteractiveStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,14">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Border Background="#F3E8FF" CornerRadius="10" Width="40" Height="40" Margin="0,0,12,0">
                                            <Path Data="M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1M12,11.99H19C18.47,15.11 15.72,18.78 12,19.93V12H5V6.3L12,3.19V11.99Z" 
                                                  Fill="#9333EA" Stretch="Uniform" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Governance" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextoColor}"/>
                                            <TextBlock Text="Rastreabilidade &amp; Fé Pública" FontSize="11" Foreground="{DynamicResource CinzaColor}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="#334155" FontSize="12.5" LineHeight="20" Margin="0,0,0,16"
                                           Text="Histórico imutável de origem e destinação final de lote. Total alinhamento com a Política Nacional de Resíduos Sólidos (PNRS - Lei 12.305/10)."/>

                                <Border Grid.Row="2" Background="#FAF5FF" CornerRadius="8" Padding="12,10" BorderThickness="1" BorderBrush="#F3E8FF">
                                    <StackPanel>
                                        <TextBlock Text="CONFORMIDADE LEGAL" FontSize="9.5" FontWeight="Bold" Foreground="#6B21A8" Margin="0,0,0,4"/>
                                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#7E22CE" FontWeight="Medium" LineHeight="16">
                                            • Suporte imediato a laudos fiscais&#10;• Dados para relatórios GRI e CDP
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                        <Border Height="4" Background="{DynamicResource RoxoEsgColor}" VerticalAlignment="Top" CornerRadius="16,16,0,0"/>
                    </Grid>
                </Grid>

                <!-- Seção Inferior: ISO 14001 Premium Card -->
                <Border Background="White" CornerRadius="16" Padding="28" BorderThickness="1" BorderBrush="#E2E8F0" VerticalAlignment="Top">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.02" Color="#0F172A"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.2*"/>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="320"/>
                        </Grid.ColumnDefinitions>

                        <!-- Conteúdo Esquerdo da ISO -->
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Border Background="#FEF3C7" CornerRadius="10" Width="44" Height="44" Margin="0,0,12,0">
                                    <Path Data="M12,15.39L8.24,17.66L9.23,13.38L5.91,10.5L10.29,10.13L12,6.1L13.71,10.13L18.09,10.5L14.77,13.38L15.76,17.66M12,2L1,21H23L12,2Z" 
                          Fill="#D97706" Stretch="Uniform" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Jornada de Certificação ISO 14001 via INMETRO" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextoColor}"/>
                                    <TextBlock Text="Utilize o ReGraphik como fonte auditável para homologação ambiental" FontSize="12" Foreground="{DynamicResource CinzaColor}"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource CinzaEscuroColor}" FontSize="13" LineHeight="22" Margin="0,0,0,24"
                       Text="O ReGraphik automatiza sua base documental. Os relatórios gerados servem como evidência de auditoria para acelerar o processo junto aos órgãos certificadores."/>

                            <!-- Timeline Interna Estilo Web -->
                            <StackPanel>
                                <!-- ETAPA 1 -->
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#F1F5F9" CornerRadius="14" Width="26" Height="26" VerticalAlignment="Top">
                                        <TextBlock Text="1" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <TextBlock FontWeight="Bold" Foreground="{DynamicResource TextoColor}" FontSize="13" Text="Exportação de Evidências Rastreáveis"/>
                                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource CinzaColor}" FontSize="12" Margin="0,2,0,0"
                                   Text="Gere o relatório digital comprobatório contendo as movimentações e destinações homologadas."/>
                                    </StackPanel>
                                </Grid>

                                <!-- ETAPA 2 -->
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#F1F5F9" CornerRadius="14" Width="26" Height="26" VerticalAlignment="Top">
                                        <TextBlock Text="2" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <TextBlock FontWeight="Bold" Foreground="{DynamicResource TextoColor}" FontSize="13" Text="Seleção do Organismo Certificador (OCA)"/>
                                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource CinzaColor}" FontSize="12" Margin="0,2,0,0"
                                   Text="Acesse o portal do INMETRO para selecionar uma entidade de auditoria credenciada em sua região."/>
                                    </StackPanel>
                                </Grid>

                                <!-- ETAPA 3 -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#DCFCE7" CornerRadius="14" Width="26" Height="26" VerticalAlignment="Top">
                                        <Path Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z" Fill="#15803D" Stretch="Uniform" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <TextBlock FontWeight="Bold" Foreground="#15803D" FontSize="13" Text="Auditoria Sem Risco &amp; Emissão do Selo"/>
                                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource CinzaColor}" FontSize="12" Margin="0,2,0,0"
                                   Text="Com a comprovação imutável do sistema, sua organização alcança o registro oficial no Certifiq."/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                        
                        <!-- PAINEL LATERAL DE AÇÕES RÁPIDAS -->
                        <Border Grid.Column="2" 
                                Background="#F8FAFC" 
                                CornerRadius="16" 
                                Padding="20" 
                                VerticalAlignment="Stretch" 
                                BorderThickness="1" 
                                BorderBrush="#E2E8F0">
                            <DockPanel LastChildFill="True">

                                <!-- SEÇÃO SUPERIOR: Título e Ação Principal -->
                                <StackPanel DockPanel.Dock="Top">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16" VerticalAlignment="Center">
                                        <Border Background="#FEF3C7" CornerRadius="8" Width="28" Height="28" Margin="0,0,10,0">
                                            <Path Data="M13,3A9,9 0 0,0 4,12A9,9 0 0,0 13,21A9,9 0 0,0 22,12A9,9 0 0,0 13,3M13,5A7,7 0 0,1 20,12A7,7 0 0,1 13,19A7,7 0 0,1 6,12A7,7 0 0,1 13,5M12,7V13H17V11.5H13.5V7H12Z" 
                                                  Fill="#D97706" Stretch="Uniform" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Ações Rápidas" 
                                                   FontWeight="Bold" 
                                                   Foreground="{DynamicResource TextoColor}" 
                                                   FontSize="14" 
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Botão Principal -->
                                    <Button Style="{StaticResource ModernButtonStyle}"  
                                            Command="{Binding IrParaRelatoriosCommand}"  
                                            Height="42"  
                                            Background="#D97706"  
                                            Foreground="White"  
                                            FontWeight="Bold"  
                                            HorizontalAlignment="Stretch" 
                                            Cursor="Hand"
                                            Margin="0,0,0,16">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="10"/>
                                            </Style>
                                        </Button.Resources>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path Data="M19,3H5C3.9,3 3,3.9 3,5V19C3,20.1 3.9,21 5,21H19C20.1,21 21,20.1 21,19V5C21,3.9 20.1,3 19,3M9,17H7V10H9V17M13,17H11V7H13V17M17,17H15V13H17V17Z" 
                                                  Fill="White" 
                                                  Stretch="Uniform" 
                                                  Width="14" 
                                                  Height="14" 
                                                  Margin="0,0,10,0" 
                                                  VerticalAlignment="Center"/>
                                            <TextBlock Text="Acessar Relatórios" 
                                                       VerticalAlignment="Center" 
                                                       FontSize="12.5"/>
                                        </StackPanel>
                                    </Button>

                                    <Separator Background="#E2E8F0" Margin="0,0,0,16"/>

                                    <TextBlock Text="LINKS DE APOIO (INMETRO)" 
                                               FontWeight="Bold" 
                                               Foreground="#94A3B8" 
                                               FontSize="10.5" 
                                               Margin="0,0,0,12"/>
                                </StackPanel>

                                <!-- SEÇÃO INFERIOR: Cards Limpos e Flexíveis -->
                                <StackPanel VerticalAlignment="Bottom">
                                    <StackPanel.Resources>
                                        <!-- Estilo limpo para remover a aparência cinza padrão do Button WPF -->
                                        <Style TargetType="Button" x:Key="CardButtonStyle">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <ContentPresenter />
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </StackPanel.Resources>

                                    <!-- Link 1: Portal INMETRO -->
                                    <Button Style="{StaticResource CardButtonStyle}"
                                            Command="{Binding AbrirLinkCommand}" 
                                            CommandParameter="https://www.gov.br/inmetro/pt-br" 
                                            Margin="0,0,0,8">
                                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12,10" HorizontalAlignment="Stretch">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Background="#EFF6FF" CornerRadius="6" Width="26" Height="26" Margin="0,0,10,0">
                                                    <Path Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,19.93C7.05,19.44 4,16.08 4,12C4,11.38 4.08,10.79 4.21,10.21L9,15V16A2,2 0 0,0 11,18V19.93M17.9,17.39C17.64,16.58 16.9,16 16,16H15V13A1,1 0 0,0 14,12H8V10H10A1,1 0 0,0 11,9V7H13A2,2 0 0,0 15,5V4.59C17.93,5.78 20,8.65 20,12C20,14.08 19.2,15.97 17.9,17.39Z" 
                                                          Fill="#2563EB" Stretch="Uniform" Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <TextBlock Grid.Column="1" Text="Portal Principal" Foreground="#1E293B" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>

                                                <Path Grid.Column="2" Data="M14,3V5H17.59L7.76,14.83L9.17,16.24L19,6.41V10H21V3M19,19H5V5H12V3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V12H19V19Z" 
                                                      Fill="#94A3B8" Stretch="Uniform" Width="11" Height="11" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </Button>

                                    <!-- Link 2: OCAs Credenciados -->
                                    <Button Style="{StaticResource CardButtonStyle}"
                                            Command="{Binding AbrirLinkCommand}" 
                                            CommandParameter="https://www.gov.br/inmetro/pt-br/acesso-a-informacao/perguntas-frequentes/acreditacao/organismos-de-sistemas-de-gestao-ambiental-oca" 
                                            Margin="0,0,0,8">
                                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12,10" HorizontalAlignment="Stretch">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Background="#EFF6FF" CornerRadius="6" Width="26" Height="26" Margin="0,0,10,0">
                                                    <Path Data="M15.5,14H14.71L14.43,13.73C15.41,12.59 16,11.11 16,9.5A6.5,6.5 0 0,0 9.5,3A6.5,6.5 0 0,0 3,9.5A6.5,6.5 0 0,0 9.5,16C11.11,16 12.59,15.41 13.73,14.43L14,14.71V15.5L19,20.49L20.49,19L15.5,14M9.5,14C7,14 5,12 5,9.5C5,7 7,5 9.5,5C12,5 14,7 14,9.5C14,12 12,14 9.5,14Z" 
                                                          Fill="#2563EB" Stretch="Uniform" Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <TextBlock Grid.Column="1" Text="Consultar OCAs" Foreground="#1E293B" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>

                                                <Path Grid.Column="2" Data="M14,3V5H17.59L7.76,14.83L9.17,16.24L19,6.41V10H21V3M19,19H5V5H12V3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V12H19V19Z" 
                                                      Fill="#94A3B8" Stretch="Uniform" Width="11" Height="11" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </Button>

                                    <!-- Link 3: Certifiq -->
                                    <Button Style="{StaticResource CardButtonStyle}"
                                            Command="{Binding AbrirLinkCommand}" 
                                            CommandParameter="https://certifiq.inmetro.gov.br">         
                                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12,10" HorizontalAlignment="Stretch">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

