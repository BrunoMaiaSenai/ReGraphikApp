<UserControl x:Class="ReGraphik.Views.Controls.ContaControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:converters="clr-namespace:ReGraphik.Converters"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:local="clr-namespace:ReGraphik.Views.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1100" Background="#F8FAFC">

    <UserControl.Resources>
        <!-- Conversores da Aplicação -->
        <converters:PasswordsToArrayConverter x:Key="PasswordsToArrayConverter" />
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>

    <!-- ScrollViewer configurado para permitir preenchimento vertical (VerticalContentAlignment="Stretch") -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Stretch">
        <Grid Margin="32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.8*"/>
                <ColumnDefinition Width="32"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- COLUNA DA ESQUERDA (Preenchimento Vertical Completo) -->
            <Grid Grid.Column="0" VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Estatísticas do Usuário -->
                <StackPanel Grid.Row="0" Margin="0,0,0,24">
                    <!-- Cabeçalho de Estatísticas -->
                    <Grid Margin="4,0,4,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <iconPacks:PackIconMaterial Kind="ChartTimelineVariant" Width="14" Height="14" Foreground="{DynamicResource CinzaColor}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="SUAS ESTATÍSTICAS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource CinzaColor}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Button Grid.Column="1" Command="{Binding AtualizarEstatisticasCommand}"
                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                    ToolTip="Atualizar estatísticas" Width="32" Height="32">
                            <iconPacks:PackIconMaterial Kind="Refresh" FontSize="16" Foreground="{DynamicResource CinzaColor}" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <iconPacks:PackIconMaterial.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </iconPacks:PackIconMaterial.RenderTransform>
                                <iconPacks:PackIconMaterial.Style>
                                    <Style TargetType="iconPacks:PackIconMaterial">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CarregandoEstatisticas}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="0" Duration="0:0:0.1"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </iconPacks:PackIconMaterial.Style>
                            </iconPacks:PackIconMaterial>
                        </Button>
                    </Grid>

                    <!-- Cards de Métricas -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Card 1 -->
                        <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="16">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="Black" Opacity="0.03" Direction="270"/>
                            </Border.Effect>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <iconPacks:PackIconMaterial Kind="Recycle" Width="14" Height="14" Foreground="{DynamicResource CinzaColor}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Resíduos" FontSize="12" Foreground="{DynamicResource CinzaColor}" FontWeight="Medium"/>
                                </StackPanel>
                                <TextBlock Text="{Binding TotalResiduos}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextoPadraoColor}"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 2 -->
                        <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="16">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="Black" Opacity="0.03" Direction="270"/>
                            </Border.Effect>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <iconPacks:PackIconMaterial Kind="Leaf" Width="14" Height="14" Foreground="{DynamicResource VerdeColor}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Reaproveitados" FontSize="12" Foreground="{DynamicResource VerdeColor}" FontWeight="Medium"/>
                                </StackPanel>
                                <TextBlock Text="{Binding TotalReaproveitados}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource VerdeColor}"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 3 -->
                        <Border Grid.Column="4" Background="White" CornerRadius="10" Padding="16">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="Black" Opacity="0.03" Direction="270"/>
                            </Border.Effect>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <iconPacks:PackIconMaterial Kind="CurrencyUsd" Width="14" Height="14" Foreground="{DynamicResource AzulMedioColor}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="Economizado" FontSize="12" Foreground="{DynamicResource AzulMedioColor}" FontWeight="Medium"/>
                                </StackPanel>
                                <TextBlock Text="{Binding ValorEconomico}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AzulMedioColor}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- Bloco do Formulário Completo (Estica até a base) -->
                <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="24" VerticalAlignment="Stretch">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" ShadowDepth="1" Color="Black" Opacity="0.04" Direction="270"/>
                    </Border.Effect>
                    <StackPanel>
                        <!-- INFORMAÇÕES PESSOAIS -->
                        <TextBlock Text="INFORMAÇÕES PESSOAIS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource CinzaColor}" Margin="0,0,0,16"/>

                        <!-- Linha 1: Nome Completo + CPF -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Nome completo" Style="{StaticResource LabelStyle}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="CPF" Style="{StaticResource LabelStyle}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding CPF}" Style="{StaticResource InputStyle}" IsReadOnly="True" Foreground="{DynamicResource TextoCinzaColor}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Linha 2: Login + Telefone/Ramal -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Usuário (Login)" Style="{StaticResource LabelStyle}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Telefone / Ramal" Style="{StaticResource LabelStyle}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding Telefone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Linha 3: E-mail Corporativo -->
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="E-mail corporativo" Style="{StaticResource LabelStyle}" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}">
                                <b:Interaction.Triggers>
                                    <b:EventTrigger EventName="GotFocus">
                                        <b:InvokeCommandAction Command="{Binding EmailGotFocusCommand}"/>
                                    </b:EventTrigger>
                                    <b:EventTrigger EventName="LostFocus">
                                        <b:InvokeCommandAction Command="{Binding EmailLostFocusCommand}"/>
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>
                            </TextBox>
                            <StackPanel Orientation="Horizontal" Margin="2,4,0,0" Visibility="{Binding MensagemErroEmail, Converter={StaticResource StringToVisibilityConverter}}">
                                <iconPacks:PackIconMaterial Kind="AlertCircleOutline" Width="12" Height="12" Foreground="{DynamicResource VermelhoColor}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding MensagemErroEmail}" Foreground="{DynamicResource VermelhoColor}" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                        <Separator Background="#F1F5F9" Margin="0,0,0,16"/>

                        <!-- DADOS PROFISSIONAIS / ORGANIZACIONAIS -->
                        <TextBlock Text="INFORMAÇÕES PROFISSIONAIS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource CinzaColor}" Margin="0,0,0,16"/>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Cargo / Função" Style="{StaticResource LabelStyle}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding Cargo}" Style="{StaticResource InputStyle}" IsReadOnly="True" Foreground="{DynamicResource TextoCinzaColor}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Departamento" Style="{StaticResource LabelStyle}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding Departamento}" Style="{StaticResource InputStyle}" IsReadOnly="True" Foreground="{DynamicResource TextoCinzaColor}"/>
                            </StackPanel>
                        </Grid>

                        <Separator Background="#F1F5F9" Margin="0,0,0,16"/>

                        <!-- SEGURANÇA -->
                        <StackPanel Margin="0,0,0,20">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="SEGURANÇA" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource CinzaColor}" VerticalAlignment="Center"/>
                                <TextBlock Text=" — ALTERAR SENHA" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AzulMedioColor}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Nova Senha" Style="{StaticResource LabelStyle}" Margin="0,0,0,6"/>
                                    <PasswordBox x:Name="TxtSenha" Style="{StaticResource PasswordStyle}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Confirmar Nova Senha" Style="{StaticResource LabelStyle}" Margin="0,0,0,6"/>
                                    <PasswordBox x:Name="TxtConfirmarSenha" Style="{StaticResource PasswordStyle}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Deixe os campos de senha em branco se não desejar alterá-la." FontSize="11" Foreground="{DynamicResource TextoCinzaColor}" Margin="2,2,0,0"/>
                        </StackPanel>

                        <!-- AÇÕES (BOTOES) -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="Cancelar" Height="40" HorizontalAlignment="Stretch"
                        Background="White" BorderBrush="{DynamicResource CinzaClaroColor}" BorderThickness="1"
                        Foreground="{DynamicResource CinzaColor}" FontWeight="SemiBold" FontSize="13"
                        Command="{Binding CancelarCommand}" Cursor="Hand" Style="{StaticResource RoundedButtonStyle}"/>

                            <Button Grid.Column="2" Content="Salvar Alterações" Height="40" HorizontalAlignment="Stretch"
                        Background="{DynamicResource AzulMedioColor}" BorderThickness="0"
                        Foreground="White" FontWeight="SemiBold" FontSize="13"
                        Command="{Binding SalvarCommand}" Cursor="Hand" Style="{StaticResource RoundedButtonStyle}">
                                <Button.CommandParameter>
                                    <MultiBinding Converter="{StaticResource PasswordsToArrayConverter}">
                                        <Binding ElementName="TxtSenha"/>
                                        <Binding ElementName="TxtConfirmarSenha"/>
                                    </MultiBinding>
                                </Button.CommandParameter>
                            </Button>
                        </Grid>

                        <!-- FEEDBACK -->
                        <StackPanel HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Visibility="{Binding MensagemSucesso, Converter={StaticResource StringToVisibilityConverter}}">
                                <iconPacks:PackIconMaterial Kind="CheckCircleOutline" Width="14" Height="14" Foreground="{DynamicResource VerdeColor}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding MensagemSucesso}" Foreground="{DynamicResource VerdeColor}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Visibility="{Binding MensagemErroGeral, Converter={StaticResource StringToVisibilityConverter}}">
                                <iconPacks:PackIconMaterial Kind="AlertCircleOutline" Width="14" Height="14" Foreground="{DynamicResource VermelhoColor}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding MensagemErroGeral}" Foreground="{DynamicResource VermelhoColor}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
            <!-- COLUNA DA DIREITA (Preenchimento Vertical Completo) -->
            <Grid Grid.Column="2" VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 1. BLOCO DE PERFIL -->
                <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" ShadowDepth="1" Color="Black" Opacity="0.04" Direction="270"/>
                    </Border.Effect>
                    <StackPanel HorizontalAlignment="Center">
                        <!-- Avatar e Botão Mudar Foto -->
                        <Grid Width="100" Height="100" Margin="0,10,0,12">
                            <Border CornerRadius="50" Background="{DynamicResource AzulMedioColor}" Visibility="{Binding SemFoto, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding Iniciais}" FontSize="28" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border CornerRadius="50" ClipToBounds="True">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding FotoPerfilCaminho}" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                            <Button Command="{Binding SelecionarFotoCommand}" Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Background="White" BorderBrush="{DynamicResource CinzaClaroColor}" BorderThickness="1" Cursor="Hand" ToolTip="Alterar Foto"
                        Style="{StaticResource RoundedButtonStyle}">
                                <iconPacks:PackIconMaterial Kind="Camera" Width="13" Height="13" Foreground="{DynamicResource CinzaEscuroColor}"/>
                            </Button>
                        </Grid>

                        <TextBlock Text="{Binding Nome}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextoColor}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding LoginExibicao}" FontSize="12" Foreground="{DynamicResource CinzaColor}" HorizontalAlignment="Center" Margin="0,2,0,10"/>

                        <Border Background="{DynamicResource VerdeFundoColor}" CornerRadius="12" Padding="10,3" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="CheckCircle" Width="12" Height="12" Foreground="{DynamicResource VerdeMedioColor}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="Conta Ativa" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource VerdeMedioColor}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 2. BLOCO DE PLANO E LICENÇA -->
                <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" ShadowDepth="1" Color="Black" Opacity="0.04" Direction="270"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="PLANO &amp; LICENÇA" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource CinzaColor}" Margin="0,0,0,14"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <iconPacks:PackIconMaterial Grid.Column="0" Kind="CrownOutline" Width="16" Height="16" Foreground="{DynamicResource AzulMedioColor}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Tipo de Plano" FontSize="11" Foreground="{DynamicResource TextoCinzaColor}"/>
                                <TextBlock Text="{Binding TipoPlano, FallbackValue='Enterprise Pro'}" FontSize="12" Foreground="{DynamicResource TextoColor}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <iconPacks:PackIconMaterial Grid.Column="0" Kind="CalendarClock" Width="16" Height="16" Foreground="{DynamicResource CinzaColor}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Expiração da Licença" FontSize="11" Foreground="{DynamicResource TextoCinzaColor}"/>
                                <TextBlock Text="{Binding DataExpiracaoLicenca, FallbackValue='31/12/2026'}" FontSize="12" Foreground="{DynamicResource TextoColor}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 3. BLOCO DE SEGURANÇA E RESUMO DA CONTA (Preenche até o final) -->
                <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="20" VerticalAlignment="Stretch">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" ShadowDepth="1" Color="Black" Opacity="0.04" Direction="270"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="SEGURANÇA E ACESSO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource CinzaColor}" Margin="0,0,0,14"/>

                        <!-- Email Principal e Status -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <iconPacks:PackIconMaterial Grid.Column="0" Kind="EmailOutline" Width="16" Height="16" Foreground="{DynamicResource CinzaColor}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="E-mail principal" FontSize="11" Foreground="{DynamicResource TextoCinzaColor}"/>
                                <TextBlock Text="{Binding EmailResumido}" FontSize="12" Foreground="{DynamicResource TextoColor}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Border Grid.Column="2" Background="{DynamicResource VerdeFundoColor}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" ToolTip="Email Confirmado">
                                <TextBlock Text="Verificado" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource VerdeMedioColor}"/>
                            </Border>
                        </Grid>

                        <Separator Background="#F1F5F9" Margin="0,0,0,10"/>

                        <!-- Perfil / Nível de Acesso -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <iconPacks:PackIconMaterial Grid.Column="0" Kind="AccountBadgeOutline" Width="16" Height="16" Foreground="{DynamicResource CinzaColor}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Nível de Acesso" FontSize="11" Foreground="{DynamicResource TextoCinzaColor}"/>
                                <TextBlock Text="{Binding Perfil}" FontSize="12" Foreground="{DynamicResource TextoColor}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>

                        <Separator Background="#F1F5F9" Margin="0,0,0,10"/>

                        <!-- Autenticação de 2 Fatores (2FA) -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <iconPacks:PackIconMaterial Grid.Column="0" Kind="ShieldCheckOutline" Width="16" Height="16" Foreground="{DynamicResource CinzaColor}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Autenticação em 2 Etapas" FontSize="11" Foreground="{DynamicResource TextoCinzaColor}"/>
                                <TextBlock Text="{Binding Status2FA, FallbackValue='Ativado'}" FontSize="12" Foreground="{DynamicResource TextoColor}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <Border Grid.Column="2" Background="{DynamicResource VerdeFundoColor}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="Ativo" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource VerdeMedioColor}"/>
                            </Border>
                        </Grid>

                        <Separator Background="#F1F5F9" Margin="0,0,0,10"/>

                        <!-- Último Acesso Registrado -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <iconPacks:PackIconMaterial Grid.Column="0" Kind="History" Width="16" Height="16" Foreground="{DynamicResource CinzaColor}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Último Acesso" FontSize="11" Foreground="{DynamicResource TextoCinzaColor}"/>
                                <TextBlock Text="{Binding UltimoAcesso, FallbackValue='Hoje às 14:32 (IP: 192.168.1.15)'}" FontSize="12" Foreground="{DynamicResource TextoColor}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>